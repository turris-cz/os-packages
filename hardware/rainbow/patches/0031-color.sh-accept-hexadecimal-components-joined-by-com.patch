From e7a005eca2c24856767c1faf32be0ce71a0662f6 Mon Sep 17 00:00:00 2001
From: Josef Schlehofer <pepe.schlehofer@gmail.com>
Date: Fri, 20 Nov 2026 19:13:44 +0100
Subject: [PATCH] color.sh: accept hexadecimal components joined by commas

The help says that a component of a color can be given in hexadecimal
with the x prefix and that the components are joined by commas. The
pattern for the comma form only allowed digits and dashes though, so
"xFF,0,0" was not a color and the prefix worked only behind R, G or B.
---
 rainbow/color.sh      | 2 +-
 rainbow/color.test.sh | 6 ++++++
 2 files changed, 7 insertions(+), 1 deletion(-)

diff --git a/rainbow/color.sh b/rainbow/color.sh
index cc214ae..fd742b0 100644
--- a/rainbow/color.sh
+++ b/rainbow/color.sh
@@ -95,7 +95,7 @@ _parse_color() {
 			;;
 	esac
 
-	if echo "$value" | grep -qE "^[0-9-]*,[0-9-]*,[0-9-]*$"; then
+	if echo "$value" | grep -qE "^([0-9-]*|x[0-9a-fA-F]+),([0-9-]*|x[0-9a-fA-F]+),([0-9-]*|x[0-9a-fA-F]+)$"; then
 		matched="y"
 		r="$(_parse_value "${value%%,*}" "$mode")" || return
 		local inter="${value%,*}"
diff --git a/rainbow/color.test.sh b/rainbow/color.test.sh
index 1d8da8b..1b65bb8 100755
--- a/rainbow/color.test.sh
+++ b/rainbow/color.test.sh
@@ -43,6 +43,12 @@ check_fail "532,0,0"
 check_fail "0,342,123"
 check_fail "42,255,256"
 
+check "xFF,0,x7f" 255 0 127
+check "x0,x0,x0" 0 0 0
+check ",x2A," "?" 42 "?"
+check_fail "x100,0,0"
+check_fail "xG,0,0"
+
 check "R0,G0,B0" 0 0 0
 check "R255,B255" 255 '?' 255
 check "R42,B1" 42 '?' 1
