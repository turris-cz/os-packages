From d06eb8b4d4d4f5e4e80759234d94f32cde623e6e Mon Sep 17 00:00:00 2001
From: Josef Schlehofer <pepe.schlehofer@gmail.com>
Date: Fri, 20 Nov 2026 15:26:20 +0100
Subject: [PATCH] backends: fix the automatic mode of the wlan LEDs

pci_device_activity_detect took both the LED and the path of the PCI
device from its first argument, so it looked for the device in a
directory named after the LED. The callers built the path of the device
with ${led#pci}, which did nothing since the LEDs were renamed from
pciN to wlan-N. The detection could not succeed and the wlan LEDs of
the Omnia were always off in the auto mode, with or without a card.

Fix the arguments and take the number from the new LED name, so that
the lookup works the way it was written for pciN. Compare the ATA
trigger by its name and not by its whole path. When the wireless card
has no network interface yet, follow its radio instead of configuring
the netdev trigger with an empty device name.

The Turris 1.x has one wlan LED and no number to derive from its name.
The detection copied from the Omnia made the phy0tpt branch below it
unreachable. Use phy0tpt directly when the kernel offers it, which is
also what the board defaults of OpenWrt do, and keep the LED off when
there is no wireless device.
---
 backend/omnia/backend.sh    |  4 +++-
 backend/turris1x/backend.sh | 15 ++++++---------
 rainbow/pci.sh              | 19 +++++++++++++++----
 3 files changed, 24 insertions(+), 14 deletions(-)

diff --git a/backend/omnia/backend.sh b/backend/omnia/backend.sh
index 1e39b97..011db57 100644
--- a/backend/omnia/backend.sh
+++ b/backend/omnia/backend.sh
@@ -62,9 +62,11 @@ set_led() {
 				mode="enable"
 				;;
 			wlan*)
+				# The LED was named pciN when this lookup was written, so N
+				# is taken for the number of the PCI bus of its slot.
 				local trigger
 				loadsrc pci
-				if trigger="$(pci_device_activity_detect "$led" "/sys/bus/pci/devices/0000:0${led#pci}:00.0")"; then
+				if trigger="$(pci_device_activity_detect "$led" "/sys/bus/pci/devices/0000:0${led#wlan-}:00.0")"; then
 					mode="activity"
 					set "$trigger"
 				else
diff --git a/backend/turris1x/backend.sh b/backend/turris1x/backend.sh
index 3f8013c..7452820 100644
--- a/backend/turris1x/backend.sh
+++ b/backend/turris1x/backend.sh
@@ -61,12 +61,12 @@ set_led() {
 			power)
 				mode="enable"
 				;;
-			wlan*)
-				local trigger
-				loadsrc pci
-				if trigger="$(pci_device_activity_detect "$led" "/sys/bus/pci/devices/0000:0${led#pci}:00.0")"; then
+			wlan)
+				# The CPLD has no hardware trigger for this LED, so follow
+				# the first wireless device when there is one.
+				if [ -n "$(supported_activities "$led" -xF 'phy0tpt')" ]; then
 					mode="activity"
-					set "$trigger"
+					set "phy0tpt"
 				else
 					mode="disable"
 				fi
@@ -77,10 +77,7 @@ set_led() {
 	local brightness=1 trigger="none"
 	case "$mode" in
 		auto)
-			case "$led" in
-				wlan) trigger="phy0tpt" ;;
-				*) trigger="turris1x-cpld" ;;
-			esac
+			trigger="turris1x-cpld"
 			;;
 		disable)
 			brightness=0
diff --git a/rainbow/pci.sh b/rainbow/pci.sh
index 77c616b..eea223c 100644
--- a/rainbow/pci.sh
+++ b/rainbow/pci.sh
@@ -11,18 +11,29 @@ loadsrc led_activity
 # If no device was detected or if activity for it is not supported it signals
 # failure with returned value.
 pci_device_activity_detect() {
-	local syspci="$1"
 	local led="$1"
+	local syspci="$2"
+	local name ata
 
 	if [ -d "$syspci/ieee80211" ]; then
-		[ -n "$(supported_activities "$led" -xF 'netdev')" ] || return
-		echo "netdev-$(ls -1 "$syspci/net" | head -1)"
+		if [ -n "$(supported_activities "$led" -xF 'netdev')" ]; then
+			name="$(ls -1 "$syspci/net" 2>/dev/null | head -1)"
+			if [ -n "$name" ]; then
+				echo "netdev-$name"
+				return
+			fi
+		fi
+		# There is no network interface yet, so follow the radio instead
+		name="$(ls -1 "$syspci/ieee80211" 2>/dev/null | head -1)"
+		[ -n "$name" ] || return
+		[ -n "$(supported_activities "$led" -xF "${name}tpt")" ] || return
+		echo "${name}tpt"
 		return
 	fi
 
 	for ata in "$syspci"/ata*; do
 		[ -d "$ata" ] || continue
-		[ -n "$(supported_activities "$led" -xF "$ata")" ] || continue
+		[ -n "$(supported_activities "$led" -xF "${ata##*/}")" ] || continue
 		echo "${ata##*/}"
 		return
 	done
