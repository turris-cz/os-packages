From 83884afb84fb3a6bee5b0d0a41faee208d57745b Mon Sep 17 00:00:00 2001
From: Josef Schlehofer <pepe.schlehofer@gmail.com>
Date: Fri, 20 Nov 2026 15:38:55 +0100
Subject: [PATCH] tests: make the unit tests pass again and add a test target

The tests were not run for a long time. state.test.sh still used the
variable names from before status was renamed to mode and expected an
empty level to be stored, and ledid.test.sh expected the power LED to
be invalid. They also started with #!/bin/ash although the code needs
bash.

Fix them, load utils.sh the way rainbow does and add cases for what
this series fixes: the checks of numbers, colors that must not reach
the shell arithmetic, times of an animation that are not numbers, a
mode that replaces the arguments of a lower level, removal of an empty
level and a leftover temporary file. "make test" runs all of them.
---
 Makefile                  |  8 ++++-
 rainbow/animation.test.sh | 12 +++++---
 rainbow/color.test.sh     | 27 +++++++++++++++--
 rainbow/ledid.test.sh     | 11 +++++--
 rainbow/state.test.sh     | 62 ++++++++++++++++++++++++++-------------
 rainbow/utils.test.sh     | 30 +++++++++++++++++++
 6 files changed, 119 insertions(+), 31 deletions(-)
 create mode 100644 rainbow/utils.test.sh

diff --git a/Makefile b/Makefile
index fbfd173..23f46a7 100644
--- a/Makefile
+++ b/Makefile
@@ -2,6 +2,12 @@ PREFIX := /usr
 
 all:
 
+test:
+	@for test in rainbow/*.test.sh; do \
+		echo "$$test"; \
+		bash "$$test" || exit 1; \
+	done
+
 install: rainbow-install button-sync-install animator-install
 
 rainbow-install:
@@ -40,4 +46,4 @@ turris1x-install:
 	install -D -m 644 backend/turris1x/animator_backend.py ${DESTDIR}${PREFIX}/libexec/rainbow/animator_backend.py
 	install -D -m 644 backend/turris1x/backend.sh ${DESTDIR}${PREFIX}/libexec/rainbow/backend.sh
 
-.PHONY: all install rainbow-install button-sync-install animator-install mox-install omnia-install turris1x-install
+.PHONY: all test install rainbow-install button-sync-install animator-install mox-install omnia-install turris1x-install
