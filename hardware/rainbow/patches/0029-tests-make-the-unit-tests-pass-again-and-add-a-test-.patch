+#!/bin/bash
 
 # SPDX-License-Identifier: GPL-3.0-or-later
 # Copyright 2022, CZ.NIC z.s.p.o. (https://www.nic.cz/)
 
 set -eu
-loadsrc() {
-	. "${0%/*}/$1.sh"
-}
+. "${0%/*}/utils.sh"
 loadsrc animation
 
