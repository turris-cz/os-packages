+/// Buffer size enough to fit `/proc/self/fd/<u64 decimal>`
+///
+/// NOTE: yes, file descriptor are 32-bit but we just have this constant by hand
+/// (and bit extra space won't kill anyone)
+const FD_PATH_BUF_SIZE: usize = crate::data::U64_DECIMAL_STR_MAX_SIZE + "/proc/self/fd/".len();
+
+/// Create path for debug VFS representation for path descriptor of current
+/// process
+pub fn path_for_fd_self(fd: &impl AsRawFd) -> ArrayString<{ FD_PATH_BUF_SIZE }> {
+	use std::fmt::Write as _;
+
+	let mut buf: ArrayString<FD_PATH_BUF_SIZE> = ArrayString::new();
+
+	buf.write_str("/proc/self/fd/").unwrap();
+	write!(buf, "{}", fd.as_raw_fd().cast_unsigned())
+		.unwrap_or_else(|_| unreachable!("buffer size miscalculation"));
+
+	buf
+}
