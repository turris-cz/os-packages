@@ -0,0 +1,143 @@
+use cap_std::AmbientAuthority;
+use rootcause::prelude::*;
+use smol_str::SmolStr;
+
+use crate::uci;
+use crate::wifi::{ApConfig, ToggleError};
+
+/// Check if all accesspoints of a network are on
+pub fn is_on(aps: &[ApConfig], network: &str) -> bool {
+	aps.iter()
+		.filter(|ap| ap.network == network)
+		.all(|ap| ap.active)
+}
+
+#[tracing::instrument(skip(config, ambient_authority))]
+pub async fn toggle(
+	config: &uci::Config<uci::configs::Wireless>,
+	network: &str,
+	enabled: bool,
+	ambient_authority: AmbientAuthority,
+) -> Result<(), Report<ToggleError>> {
+	_ = ambient_authority;
+
+	let value = if !enabled { "1" } else { "0" };
+	let network = SmolStr::new(network);
+	let do_reload = config
+		.update(move |document| {
+			let relevant_sections =
+				document
+					.lookup_by_type_mut("wifi-iface")
+					.filter(move |(_, config)| match config.get("network") {
+						Some(items) => items.iter().any(|n| n == network),
+						None => false,
+					});
+
+			relevant_sections.fold(false, |needs_reload, (_, section)| {
+				let current_would_change = section
+					.get("disabled")
+					.and_then(|opt| opt.try_as_bool().ok())
+					.map(|disabled| disabled == enabled)
+					.unwrap_or(true);
+
+				if current_would_change {
+					if let Err(error) = section.insert("disabled", value.into()) {
+						unreachable!("value is assumed valid: {error:?}");
+					}
+				}
+
+				needs_reload | current_would_change
+			})
+		})
+		.await
+		.context(ToggleError::Commit)?;
+
+	if do_reload {
+		tracing::info!("reloading Wi-Fi configuration");
+		if let Err(error) = tokio::process::Command::new("wifi").arg("reconf").spawn() {
+			tracing::error!(?error, "failed to execute `wifi reconf`");
+		}
+	} else {
+		tracing::debug!("Wi-Fi configuration is already in specified state, skipping reload");
+	}
+
+	Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+	use assert2::check;
+	use cap_std::fs_utf8::Dir;
+	use cap_std::io_lifetimes::FromFd;
+
+	use super::*;
+	use crate::wifi::ApConfigStore;
+
+	fn test_section<'a>(
+		document: &mut ucifer::Document<'a>,
+		name: &'a str,
+		network: &'a str,
+		state: bool,
+	) {
+		let mut section = ucifer::document::Section::default();
+		let state_str = if state { "0" } else { "1" };
+		section
+			.insert("disabled", ucifer::ConfigOption::Scalar(state_str.into()))
+			.unwrap();
+
+		section
+			.insert("network", ucifer::ConfigOption::Scalar(network.into()))
+			.unwrap();
+
+		section
+			.insert("ssid", ucifer::ConfigOption::Scalar(name.into()))
+			.unwrap();
+
+		document.insert("wifi-iface", Some(name), section).unwrap();
+	}
+
+	#[tokio::test]
+	#[ignore]
+	async fn group_toggle() -> Result<(), Report> {
+		// TODO: private mount detection for resolution?
+
+		let mut config_store = ApConfigStore::default();
+		let tempdir = ptmpfs::create(
+			None,
+			ptmpfs::Mode::RWXU,
+			ptmpfs::CreateFlags::empty(),
+			ptmpfs::MountAttrFlags::MOUNT_ATTR_NOSUID
+				| ptmpfs::MountAttrFlags::MOUNT_ATTR_NOEXEC
+				| ptmpfs::MountAttrFlags::MOUNT_ATTR_NODEV,
+		)?;
+
+		let dir = Dir::from_into_fd(tempdir);
+		dir.create("wireless")?;
+
+		let uci = uci::init(dir.try_clone()?, cap_std::ambient_authority()).await?;
+		let wifi = uci.request::<uci::configs::Wireless>().await?;
+
+		wifi.update(|document| {
+			test_section(document, "ap24", "lan", false);
+			test_section(document, "ap5", "lan", false);
+			test_section(document, "cat", "nyan", true);
+		})
+		.await?;
+
+		{
+			let document = wifi.get().await;
+			config_store.update(document.get()).for_each(|_| ());
+			check!(!is_on(config_store.access_points(), "lan"));
+		}
+
+		toggle(&wifi, "lan", true, cap_std::ambient_authority()).await?;
+
+		{
+			let document = wifi.get().await;
+			config_store.update(document.get()).for_each(|_| ());
+			check!(is_on(config_store.access_points(), "lan"));
+		}
+
+		Ok(())
+	}
+}
