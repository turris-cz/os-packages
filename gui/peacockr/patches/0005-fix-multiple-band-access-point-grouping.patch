-//! Wi-Fi access point associations store
-
-use hardware_address::MacAddr;
-use hashbrown::HashMap;
-use tracing::debug;
-use uom::si::u64::Frequency;
-
-use crate::wifi::PowerLevel;
-
-/// Stores imported associations
-#[derive(Debug, Default)]
-pub struct AssociationStore {
-	pub associations: HashMap<MacAddr, Association>,
-}
-
-impl AssociationStore {
-	/// Update association store from event
-	pub fn update(&mut self, event: Event) {
-		match event {
-			Event::Probe {
-				address,
-				signal,
-				frequency,
-			} => {
-				let Some(entry) = self.associations.get_mut(&address) else {
-					tracing::trace!(?address, "Got probe event for association we do not track");
-					return;
-				};
-
-				entry.signal = signal;
-				entry.frequency = frequency;
-			}
-
-			Event::Assoc {
-				address,
-				target: _,
-				signal,
-				frequency,
-			} => {
-				_ = self.associations.insert(
-					address,
-					Association {
-						mac: address,
-						signal,
-						frequency,
-					},
-				);
-			}
-
-			Event::Disassoc { address } => {
-				let removed = self.associations.remove(&address);
-				if removed.is_none() {
-					debug!(%address, "Got disassociate event for unknown station");
-				}
-			}
-		}
-	}
-}
-
-/// Wi-Fi association
-#[derive(Debug)]
-pub struct Association {
-	/// MAC address of such association
-	pub mac:       MacAddr,
-	/// Signal strength (dBmW)
-	pub signal:    PowerLevel,
-	/// Connected frequency
-	pub frequency: Frequency,
-}
-
-#[derive(Debug)]
-pub enum Event {
-	Probe {
-		address:   MacAddr,
-		signal:    PowerLevel,
-		frequency: Frequency,
-	},
