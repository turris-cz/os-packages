diff --git a/frontend/src/wifi/associations.rs b/frontend/src/wifi/associations.rs
new file mode 100644
index 0000000..7cad32d
--- /dev/null
+++ b/frontend/src/wifi/associations.rs
@@ -0,0 +1,361 @@
+use std::cell::RefCell;
+use std::fmt::Display;
+use std::rc::Rc;
+
+use futures_util::{Stream, StreamExt, TryStreamExt};
+use hardware_address::MacAddr;
+use peacockr_backend::hosts::Hostnames;
+use peacockr_backend::hosts::oui::OuiDb;
+use peacockr_backend::reexports::hashbrown::{self, HashMap};
+use peacockr_backend::wifi::{PowerLevel, assoc};
+use rootcause::prelude::*;
+use slint::{ComponentHandle as _, ModelNotify, ModelRc, ToSharedString};
+use smol_str::SmolStr;
+use tokio::sync::mpsc;
+use tokio::task::JoinHandle;
+use uom::si::frequency::kilohertz;
+use uom::si::u64::Frequency;
+
+use crate::api::DynamicHostEvent;
+use crate::{UbusCapability, ui};
+
+pub fn bind(
+	app: &ui::App,
+	ubus: Option<UbusCapability>,
+	oui_db: OuiDb,
+	mut dynamic_hosts_rx: mpsc::Receiver<DynamicHostEvent>,
+) -> Result<(), Report> {
+	let readouts = app.global::<ui::Readouts>();
+
+	let ap_map = Rc::new(RefCell::new(HashMap::new()));
+	let (tx, mut rx) = mpsc::channel(8);
+
+	readouts.on_assoc_subscribe_switch({
+		let ap_map = Rc::clone(&ap_map);
+		let app = app.clone_strong();
+
+		move |ap, class, shall_be_enabled| {
+			let mut map = ap_map.borrow_mut();
+			switch_handle(
+				&app,
+				ubus.as_ref(),
+				&mut map,
+				&tx,
+				ap,
+				class,
+				shall_be_enabled,
+			);
+		}
+	});
+
+	slint::spawn_local(async move {
+		let mut hostnames = Hostnames::default();
+		// TODO: loop termination on all streams exhausted
+
+		loop {
+			tokio::select! {
+				Some((ap, event)) = rx.recv() => {
+					let mut map = ap_map.borrow_mut();
+
+					on_event(&mut map, &oui_db, &hostnames, &ap, event);
+				},
+				Some(event) = dynamic_hosts_rx.recv() => {
+					update_dynamic_hosts(&ap_map.borrow(), &mut hostnames, &oui_db, event);
+				},
+			}
+		}
+	})?;
+
+	Ok(())
+}
+
+fn update_dynamic_hosts(
+	ap_map: &HashMap<SmolStr, Subscription>,
+	hostnames: &mut Hostnames,
+	oui: &OuiDb,
+	event: DynamicHostEvent,
+) {
+	let mac;
+	match event {
+		DynamicHostEvent::New { address, hostname } => {
+			mac = address;
+			if let Some(hostname) = hostname {
+				hostnames.dynamic_acquire(address, &hostname);
+			}
+		}
+		DynamicHostEvent::Remove(address) => {
+			mac = address;
+			hostnames.dynamic_release(address);
+		}
+	}
+
+	let hostname = peacockr_backend::hosts::device_friendly_name(hostnames, oui, mac);
+	for entry in ap_map.values() {
+		entry.model.update(mac, |entry| {
+			entry.hostname = hostname.to_shared_string();
+		});
+	}
+}
+
+fn on_event(
+	map: &mut HashMap<SmolStr, Subscription>,
+	oui_db: &OuiDb,
+	hostnames: &Hostnames,
+	ap: &str,
+	event: assoc::Event,
+) {
+	let Some(subscription) = map.get(ap) else {
+		tracing::warn!("got unsolicited AP event, ignoring");
+		return;
+	};
+
+	match event {
+		assoc::Event::Probe {
+			address,
+			signal,
+			frequency: _,
+		} => {
+			subscription.model.update(address, |assoc| {
+				assoc.signal = signal as _;
+			});
+		}
+		assoc::Event::Assoc {
+			address,
+			target: _,
+			signal,
+			frequency,
+		} => {
+			let hostname =
+				peacockr_backend::hosts::device_friendly_name(hostnames, oui_db, address);
+
+			subscription
+				.model
+				.insert(address, hostname, signal, frequency);
+		}
+		assoc::Event::Disassoc { address } => {
+			subscription.model.remove(address);
+		}
+	}
+}
+
+fn switch_handle(
+	app: &ui::App,
+	ubus: Option<&UbusCapability>,
+	tasks: &mut HashMap<SmolStr, Subscription>,
+	tx: &mpsc::Sender<(SmolStr, assoc::Event)>,
+	ap: slint::SharedString,
+	class: ui::ApClassification,
+	shall_be_enabled: bool,
+) {
+	if shall_be_enabled {
+		let ap = SmolStr::new(ap);
+		let task_entry = tasks.entry(ap.clone());
+		if let hashbrown::hash_map::Entry::Occupied(task_entry) = &task_entry {
+			let entry = task_entry.get();
+			if entry.task_h.is_finished() {
+				tasks.remove(&ap);
+				return;
+			}
+		}
+
+		let tx = tx.clone();
+		let task_h = match ubus {
+			Some(ubus) => {
+				let ubus = ubus.clone();
+				tokio::spawn(async move {
+					let mut buffer = [0; 4096];
+					match for_ubus_hostapd(&mut buffer, &ubus, ap).await {
+						Ok(stream) => pipe_events(stream, tx).await,
+						Err(error) => {
+							tracing::error!(?error, "failed to establish hostapd monitoring")
+						}
+					}
+				})
+			}
+			None => tokio::spawn(pipe_events(mock_events(ap), tx)),
+		};
+
+		let model = Rc::default();
+		task_entry.insert(Subscription {
+			task_h,
+			model: Rc::clone(&model),
+		});
+
+		let readouts = app.global::<ui::Readouts>();
+		match class {
+			ui::ApClassification::Primary => {
+				readouts.set_ap_primary(ui::ApDetails {
+					associations: ModelRc::from(model),
+					..readouts.get_ap_primary()
+				});
+			}
+			ui::ApClassification::Guest => {
+				readouts.set_ap_guest(ui::ApDetails {
+					associations: ModelRc::from(model),
+					..readouts.get_ap_guest()
+				});
+			}
+		}
+	} else {
+		if let Some(entry) = tasks.remove(&ap[..]) {
+			entry.task_h.abort();
+			entry.model.clear();
+		}
+	}
+}
+
+async fn pipe_events<S>(stream: S, tx: mpsc::Sender<(SmolStr, assoc::Event)>)
+where
+	S: Stream<Item = Result<(SmolStr, assoc::Event), Report>>,
+{
+	let mut stream = std::pin::pin!(stream);
+
+	while let Some(event) = stream.next().await {
+		let do_break = match event {
+			Ok(event) => {
+				let result = tx.send(event).await;
+				result.is_err()
+			}
+			Err(error) => {
+				tracing::error!(?error, "monitoring failed");
+				true
+			}
+		};
+
+		if do_break {
+			break;
+		}
+	}
+}
+
+struct Subscription {
+	task_h: JoinHandle<()>,
+	model:  Rc<Model>,
+}
+
+#[derive(Clone)]
+struct AssociationEntry {
+	mac:   MacAddr,
+	inner: ui::Association,
+}
+
+#[derive(Default)]
+struct Model {
+	data:   RefCell<Vec<AssociationEntry>>,
+	notify: ModelNotify,
+}
+
+impl Model {
+	/// Remove all entries and notify
+	fn clear(&self) {
+		self.data.borrow_mut().clear();
+		self.notify.reset();
+	}
+
+	/// Push new entry, overriding if already present
+	fn insert(&self, mac: MacAddr, hostname: impl Display, signal: PowerLevel, _freq: Frequency) {
+		let was_found = self.update(mac, |assoc| {
+			assoc.signal = signal as _;
+		});
+
+		if !was_found {
+			{
+				let mut data = self.data.borrow_mut();
+				data.push(AssociationEntry {
+					mac,
+					inner: ui::Association {
+						eui48:      mac.to_shared_string(),
+						hostname:   hostname.to_shared_string(),
+						link_speed: 0,
+						signal:     signal as _,
+					},
+				});
+			}
+
+			self.notify.row_added(0, 1);
+		}
+	}
+
+	/// Modify entry, returns [`true`] if found, otherwise [`false`]
+	fn update(&self, mac: MacAddr, f: impl FnOnce(&mut ui::Association)) -> bool {
+		let position;
+		{
+			let mut data = self.data.borrow_mut();
+			let Some((index, item)) = data
+				.iter_mut()
+				.enumerate()
+				.find(|(_, item)| item.mac == mac)
+			else {
+				return false;
+			};
+
+			f(&mut item.inner);
+			position = data.len() - index - 1;
+		}
+
+		self.notify.row_changed(position);
+		true
+	}
+
+	/// Remove entry in the store
+	fn remove(&self, mac: MacAddr) {
+		let position;
+		{
+			let mut data = self.data.borrow_mut();
+			let Some(index) = data.iter().position(|item| item.mac == mac) else {
+				return;
+			};
+
+			data.remove(index);
+
+			position = data.len() - index;
+		}
+
+		self.notify.row_removed(position, 1);
+	}
+}
+
+impl slint::Model for Model {
+	type Data = ui::Association;
+
+	fn row_count(&self) -> usize {
+		self.data.borrow().len()
+	}
+
+	fn row_data(&self, row: usize) -> Option<Self::Data> {
+		let data = self.data.borrow();
+		let rev_index = data.len().checked_sub(row + 1)?;
+		let row = data.get(rev_index)?;
+		Some(row.inner.clone())
+	}
+
+	fn model_tracker(&self) -> &dyn slint::ModelTracker {
+		&self.notify
+	}
+}
+
+/// Pekný argument, senátor, prečo to nepodložíte zdrojom? Môj zdroj je, že som
+/// si to vymyslel.
+fn mock_events(ap: SmolStr) -> impl Stream<Item = Result<(SmolStr, assoc::Event), Report>> {
+	let mock = [assoc::Event::Assoc {
+		address:   MacAddr::from_raw([0xD8, 0x58, 0xD7, 0xDD, 0xEE, 0xFF]),
+		target:    MacAddr::new(),
+		signal:    -30,
+		frequency: Frequency::new::<kilohertz>(2400),
+	}];
+
+	futures_util::stream::iter(mock).map(move |event| Ok((ap.clone(), event)))
+}
+
+/// Source events from `hostapd` on uBus socket
+async fn for_ubus_hostapd<'b>(
+	buffer: &'b mut [u8],
+	ubus: &UbusCapability,
+	ap: SmolStr,
+) -> Result<impl Stream<Item = Result<(SmolStr, assoc::Event), Report>> + use<'b>, Report> {
+	let ubus = ubus.connect().await?;
+	let stream = peacockr_backend::wifi::hostapd::events(buffer, ubus, &ap).await?;
+	let tagged = stream.map_ok(move |event| (ap.clone(), event));
+
+	Ok(tagged)
+}
